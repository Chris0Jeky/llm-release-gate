{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Chris0Jeky/llm-release-gate/schemas/run-snapshot-v1.schema.json",
  "title": "llm-release-gate RunSnapshot v1 (proposal)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_sha256",
    "plan_sha256",
    "dataset_sha256",
    "config_sha256",
    "adapter",
    "execution",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "snapshot_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "dataset_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "adapter": {
      "$ref": "#/$defs/component"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "executor"
      ],
      "properties": {
        "mode": {
          "enum": [
            "replay",
            "imported",
            "live",
            "application"
          ]
        },
        "executor": {
          "$ref": "#/$defs/component"
        },
        "provenance": {
          "type": "object",
          "description": "Bounded non-secret provenance. Volatile timestamps/URLs belong in a separate capture manifest when they must not affect snapshot identity.",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_tokens",
        "completion_tokens"
      ],
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "request_sha256",
        "status"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "request_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "ok",
            "error"
          ]
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            }
          }
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            }
          }
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "required": [
              "output"
            ],
            "not": {
              "required": [
                "error"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "error"
              }
            }
          },
          "then": {
            "required": [
              "error"
            ],
            "not": {
              "required": [
                "output"
              ]
            }
          }
        }
      ]
    }
  }
}
